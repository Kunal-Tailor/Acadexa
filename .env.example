# Acadexa — environment configuration template
# Copy to .env and fill in local values. Never commit .env.

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=acadexa

# Application
ACADEXA_ENV=development

# PySpark Local Mode
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_APP_NAME=Acadexa
SPARK_SHUFFLE_PARTITIONS=8
SPARK_DEFAULT_PARALLELISM=4
